{
  "name": "mac-sys-sounds",
  "version": "0.1.2",
  "author": "Yap@house",
  "description": "Play macOS system sounds on the CLI.",
  "keywords": [
    "macos",
    "sound",
    "cli"
  ],
  "homepage": "https://github.com/yap-house/mac-sys-sounds#readme",
  "license": "MIT",
